---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {
  getChapterSlug,
  getPdfEntriesForSubject,
  getSubjectBySlug,
  getSubjectSlug,
  groupChapters,
  notesForSubject,
  type Language
} from "../../../../lib/notes";
import { chapterKind, chapterKindLabel, subjectHue } from "../../../../lib/ui";

export async function getStaticPaths() {
  const notes = await getCollection("notes");

  return notes.map((note) => ({
    params: {
      subject: getSubjectSlug(note),
      chapter: getChapterSlug(note),
      lang: note.data.language
    },
    props: { noteId: note.id }
  }));
}

const { noteId } = Astro.props;
const notes = await getCollection("notes");
const note = notes.find((entry) => entry.id === noteId);

if (!note) {
  throw new Error(`Missing note entry: ${noteId}`);
}

const subjectSlug = getSubjectSlug(note);
const subject = getSubjectBySlug(subjectSlug);

if (!subject) {
  throw new Error(`Missing subject registry entry for ${subjectSlug}`);
}

const chapterSlug = getChapterSlug(note);
const language = note.data.language as Language;
const { Content, headings } = await render(note);

const subjectNotes = notesForSubject(notes, subject.slug);
const pdfs = getPdfEntriesForSubject(subject.slug);
const chapters = groupChapters(subjectNotes, pdfs);
const currentChapter = chapters.find((chapter) => chapter.chapter === note.data.chapter && chapter.slug === chapterSlug);
const languageNotes = subjectNotes
  .filter((entry) => entry.data.language === language)
  .sort((a, b) => a.data.chapter - b.data.chapter || getChapterSlug(a).localeCompare(getChapterSlug(b)));
const currentLanguageIndex = languageNotes.findIndex((entry) => entry.id === note.id);
const previousNote = languageNotes[currentLanguageIndex - 1];
const nextNote = languageNotes[currentLanguageIndex + 1];
const previousHref = previousNote ? `/${subject.slug}/${getChapterSlug(previousNote)}/${language}/` : undefined;
const nextHref = nextNote ? `/${subject.slug}/${getChapterSlug(nextNote)}/${language}/` : undefined;

const alternateEn = currentChapter?.en;
const alternateBn = currentChapter?.bn;
const originalPdf = currentChapter?.pdf;
const pagefindChapter = `Chapter ${note.data.chapter}: ${note.data.title}`;
const hue = subjectHue(subject.slug);
const kind = chapterKind(note.data.title, note.data.chapter);

const readingTime = (() => {
  const text = note.body || "";
  const words = text.trim().split(/\s+/).filter(Boolean).length;
  const mins = Math.max(1, Math.ceil(words / 200));
  return language === "bn" ? `${mins} মিনিট` : `${mins} min read`;
})();
---

<BaseLayout
  title={`${subject.code} Chapter ${note.data.chapter} - ${note.data.title}`}
  lang={language}
  hue={hue}
>
  <main class="site-main note-page">
    <header class="note-header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href={`/${subject.slug}/`}>{subject.code}</a>
        <span>/</span>
        <span>Chapter {note.data.chapter}</span>
        {
          originalPdf && (
            <>
              <span>·</span>
              <a href={originalPdf.url} target="_blank" rel="noopener noreferrer">
                View original PDF
              </a>
            </>
          )
        }
      </nav>

      <p class="note-kind">
        <span class="chapter-badge" data-kind={kind}>{chapterKindLabel(kind)}</span>
        <span class="chapter-index">Chapter {note.data.chapter}</span>
        <span aria-hidden="true">·</span>
        <span class="reading-time">{readingTime}</span>
      </p>

      <h1>{note.data.title}</h1>

      <div class="language-toggle" aria-label="Language">
        {
          alternateEn ? (
            <a
              class:list={["pill", language === "en" && "active"]}
              href={`/${subject.slug}/${chapterSlug}/en/`}
              aria-current={language === "en" ? "page" : undefined}
            >
              {"EN"}
            </a>
          ) : (
            <span class="pill disabled" aria-disabled="true">{"EN"}</span>
          )
        }
        {
          alternateBn ? (
            <a
              class:list={["pill", language === "bn" && "active"]}
              href={`/${subject.slug}/${chapterSlug}/bn/`}
              aria-current={language === "bn" ? "page" : undefined}
            >
              {"BN"}
            </a>
          ) : (
            <span class="pill disabled" aria-disabled="true">{"BN"}</span>
          )
        }
      </div>
    </header>

    <nav class="chapter-nav chapter-nav-top" aria-label="Chapter navigation">
      {
        previousHref ? (
          <a class="chapter-nav-link" href={previousHref}>{"\u2190 Previous"}</a>
        ) : (
          <span class="chapter-nav-link disabled" aria-disabled="true">{"\u2190 Previous"}</span>
        )
      }
      {
        nextHref ? (
          <a class="chapter-nav-link" href={nextHref}>{"Next \u2192"}</a>
        ) : (
          <span class="chapter-nav-link disabled" aria-disabled="true">{"Next \u2192"}</span>
        )
      }
    </nav>

    <div class="pagefind-data" data-pagefind-ignore>
      <span data-pagefind-meta={`subject:${subject.code}`} data-pagefind-filter={`subject:${subject.code}`}></span>
      <span data-pagefind-meta={`chapter:${pagefindChapter}`}></span>
      <span data-pagefind-meta={`language:${language}`} data-pagefind-filter={`language:${language}`}></span>
    </div>

    {kind === "flashcards" && (
      <div class="flashcard-toolbar" data-flashcard-toolbar>
        <div class="flashcard-progress">
          <span data-count>— cards</span>
          <span data-due></span>
        </div>
        <div class="flashcard-actions">
          <button class="button" type="button" data-toggle>Study mode</button>
          <button class="button" type="button" data-shuffle>Shuffle</button>
          <button class="button" type="button" data-reset>Reset</button>
        </div>
      </div>
    )}

    {kind === "flashcards" && (
      <div class="flashcard-study hidden" data-flashcard-study aria-live="polite">
        <div class="flashcard-card" data-card>
          <div class="flashcard-front" data-front></div>
          <div class="flashcard-back hidden" data-back></div>
        </div>
        <div class="flashcard-controls">
          <button class="button" type="button" data-flip>Show answer</button>
          <div class="flashcard-grade hidden" data-grade>
            <button class="button" type="button" data-again>Again</button>
            <button class="button pill active" type="button" data-good>Good</button>
          </div>
          <span class="flashcard-progress-text" data-progress></span>
        </div>
      </div>
    )}

    {
      headings.length > 0 ? (
        <div class:list={["note-layout", "has-toc"]}>
          <aside class="note-toc" aria-label="Jump to section">
            <p class="note-toc-title">Jump to</p>
            <ol class="note-toc-list">
              {headings.map((h) => (
                <li>
                  <a class="note-toc-link" href={`#${h.slug}`}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </aside>
          <article class="note-content" data-pagefind-body>
            <Content />
          </article>
        </div>
      ) : (
        <article class="note-content" data-pagefind-body>
          <Content />
        </article>
      )
    }

    <script is:inline>
        (() => {
          const toc = document.querySelector(".note-toc");
          if (toc) {
            const links = Array.from(toc.querySelectorAll(".note-toc-link"));
            const ids = links.map((a) => a.getAttribute("href")?.slice(1)).filter(Boolean);
            const targets = ids.map((id) => document.getElementById(id)).filter(Boolean);
            if (targets.length) {
              const obs = new IntersectionObserver(
                (entries) => {
                  let active = null;
                  entries.forEach((e) => {
                    if (e.isIntersecting) active = e.target.id;
                  });
                  if (active) {
                    links.forEach((a) => a.classList.toggle("is-active", a.getAttribute("href") === `#${active}`));
                  }
                },
                { rootMargin: "-40% 0px -50% 0px", threshold: 0 }
              );
              targets.forEach((el) => obs.observe(el));
            }
          }
        })();
    </script>

    <script is:inline>
        (() => {
          const toolbar = document.querySelector("[data-flashcard-toolbar]");
          const study = document.querySelector("[data-flashcard-study]");
          const noteContent = document.querySelector(".note-content");
          if (!toolbar || !study || !noteContent) return;

          const details = Array.from(noteContent.querySelectorAll("details"));
          if (!details.length) {
            toolbar.style.display = "none";
            study.style.display = "none";
            return;
          }

          const cards = details.map((d, i) => {
            const summary = d.querySelector("summary");
            const q = summary ? summary.innerHTML : `Card ${i+1}`;
            // clone details, remove summary to get answer html
            const clone = d.cloneNode(true);
            const s = clone.querySelector("summary");
            if (s) s.remove();
            const a = clone.innerHTML.trim() || "<em>No answer</em>";
            return { q, a, idx: i };
          });

          const storageKey = `flashcards:${window.location.pathname}`;
          const load = () => {
            try {
              const raw = localStorage.getItem(storageKey);
              if (!raw) return {};
              return JSON.parse(raw);
            } catch { return {}; }
          };
          const save = (data) => {
            try { localStorage.setItem(storageKey, JSON.stringify(data)); } catch {}
          };
          let state = load(); // { [idx]: {interval,repetition,ease,due} }
          const now = () => Date.now();
          const DAY = 24*60*60*1000;

          const getCardState = (idx) => state[idx] || { interval: 0, repetition: 0, ease: 2.5, due: 0 };
          const isDue = (s) => !s.due || s.due <= now();

          let queue = [];
          let current = 0;
          let studyMode = false;

          const front = study.querySelector("[data-front]");
          const back = study.querySelector("[data-back]");
          const flipBtn = study.querySelector("[data-flip]");
          const gradeBox = study.querySelector("[data-grade]");
          const againBtn = study.querySelector("[data-again]");
          const goodBtn = study.querySelector("[data-good]");
          const progressText = study.querySelector("[data-progress]");
          const countEl = toolbar.querySelector("[data-count]");
          const dueEl = toolbar.querySelector("[data-due]");
          const toggleBtn = toolbar.querySelector("[data-toggle]");
          const shuffleBtn = toolbar.querySelector("[data-shuffle]");
          const resetBtn = toolbar.querySelector("[data-reset]");

          const rebuildQueue = (shuffle=false) => {
            const dueCards = [];
            const newCards = [];
            cards.forEach((c) => {
              const s = getCardState(c.idx);
              if (isDue(s)) dueCards.push(c);
              else newCards.push(c);
            });
            // due first, then new; or if no due, show all
            queue = dueCards.length ? dueCards : cards.slice();
            if (shuffle) {
              for (let i=queue.length-1;i>0;i--) {
                const j = Math.floor(Math.random()*(i+1));
                [queue[i],queue[j]]=[queue[j],queue[i]];
              }
            }
            current = 0;
          };

          const updateProgress = () => {
            const dueCount = cards.filter(c => isDue(getCardState(c.idx))).length;
            if (countEl) countEl.textContent = `${cards.length} cards`;
            if (dueEl) dueEl.textContent = dueCount ? `· ${dueCount} due` : `· all caught up`;
            if (progressText) progressText.textContent = studyMode ? `${current+1} / ${queue.length}` : "";
          };

          const render = () => {
            if (!queue.length) return;
            const card = queue[current];
            if (!card) return;
            front.innerHTML = card.q;
            back.innerHTML = card.a;
            back.classList.add("hidden");
            gradeBox.classList.add("hidden");
            flipBtn.classList.remove("hidden");
            flipBtn.textContent = "Show answer";
            updateProgress();
          };

          flipBtn.addEventListener("click", () => {
            back.classList.remove("hidden");
            gradeBox.classList.remove("hidden");
            flipBtn.classList.add("hidden");
          });

          const grade = (quality) => {
            const card = queue[current];
            if (!card) return;
            const s = getCardState(card.idx);
            if (quality === "again") {
              s.repetition = 0;
              s.interval = 0;
              s.ease = Math.max(1.3, s.ease - 0.2);
              s.due = now();
            } else {
              // good
              if (s.repetition === 0) s.interval = 1;
              else if (s.repetition === 1) s.interval = 6;
              else s.interval = Math.round(s.interval * s.ease);
              s.repetition += 1;
              s.ease = Math.min(3, s.ease + 0.05);
              s.due = now() + s.interval * DAY;
            }
            state[card.idx] = s;
            save(state);
            // move to next, or if Again put card at end
            if (quality === "again") {
              queue.push(queue.splice(current,1)[0]);
              if (current >= queue.length) current = 0;
            } else {
              // Good: remove from queue if it was due and now not due? Keep simple: next
              current += 1;
              if (current >= queue.length) {
                // rebuild to pick next due or loop
                rebuildQueue(false);
              }
            }
            render();
          };

          againBtn.addEventListener("click", () => grade("again"));
          goodBtn.addEventListener("click", () => grade("good"));

          toggleBtn.addEventListener("click", () => {
            studyMode = !studyMode;
            if (studyMode) {
              rebuildQueue(false);
              study.classList.remove("hidden");
              noteContent.classList.add("flashcard-study-active");
              toggleBtn.textContent = "List mode";
              toggleBtn.classList.add("pill","active");
              render();
            } else {
              study.classList.add("hidden");
              noteContent.classList.remove("flashcard-study-active");
              toggleBtn.textContent = "Study mode";
              toggleBtn.classList.remove("pill","active");
              updateProgress();
            }
          });

          shuffleBtn.addEventListener("click", () => {
            if (!studyMode) {
              studyMode = true;
              study.classList.remove("hidden");
              noteContent.classList.add("flashcard-study-active");
              toggleBtn.textContent = "List mode";
              toggleBtn.classList.add("pill","active");
            }
            rebuildQueue(true);
            render();
          });

          resetBtn.addEventListener("click", () => {
            if (!confirm("Reset progress for this deck?")) return;
            localStorage.removeItem(storageKey);
            state = {};
            rebuildQueue(false);
            updateProgress();
            if (studyMode) render();
          });

          // init
          rebuildQueue(false);
          updateProgress();
          // also re-render on click of card to flip
          study.querySelector("[data-card]").addEventListener("click", (e) => {
            if (e.target.closest("button")) return;
            if (!back.classList.contains("hidden")) return;
            flipBtn.click();
          });
        })();
    </script>

    <nav class="chapter-nav chapter-nav-bottom" aria-label="Chapter navigation">
      {
        previousHref ? (
          <a class="chapter-nav-link" href={previousHref}>{"\u2190 Previous"}</a>
        ) : (
          <span class="chapter-nav-link disabled" aria-disabled="true">{"\u2190 Previous"}</span>
        )
      }
      {
        nextHref ? (
          <a class="chapter-nav-link" href={nextHref}>{"Next \u2192"}</a>
        ) : (
          <span class="chapter-nav-link disabled" aria-disabled="true">{"Next \u2192"}</span>
        )
      }
    </nav>
  </main>
</BaseLayout>
