---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allSubjects } from "../../config/subjects";
import { getPdfEntriesForSubject, groupChapters, notesForSubject } from "../../lib/notes";
import { chapterKind, chapterKindLabel, subjectHue } from "../../lib/ui";

export function getStaticPaths() {
  return allSubjects.map((subject) => ({
    params: { subject: subject.slug },
    props: { subject }
  }));
}

const { subject } = Astro.props;
const notes = await getCollection("notes");
const pdfs = getPdfEntriesForSubject(subject.slug);
const chapters = groupChapters(notesForSubject(notes, subject.slug), pdfs);
const hue = subjectHue(subject.slug);

const decorated = chapters.map((chapter) => ({
  ...chapter,
  kind: chapterKind(chapter.title, chapter.chapter)
}));

const counts = decorated.reduce<Record<string, number>>((acc, chapter) => {
  acc[chapter.kind] = (acc[chapter.kind] ?? 0) + 1;
  return acc;
}, {});
---

<BaseLayout title={`${subject.code} - ${subject.name}`} hue={hue}>
  <main class="site-main">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span>{subject.code}</span>
    </nav>

    <header class="page-header subject-header">
      <p class="eyebrow">{subject.code}</p>
      <h1>{subject.name}</h1>
      {
        decorated.length > 0 && (
          <ul class="tally" aria-label="Chapter breakdown">
            {Object.entries(counts).map(([kind, n]) => (
              <li class="tally-item" data-kind={kind}>
                <strong>{n}</strong> {chapterKindLabel(kind as any).toLowerCase()}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      decorated.length === 0 ? (
        <p class="empty-state">No chapters yet</p>
      ) : (
        <ol class="chapter-list">
          {decorated.map((chapter) => (
            <li class="chapter-row" data-kind={chapter.kind}>
              <div class="chapter-main">
                <p class="chapter-number">
                  <span class="chapter-badge" data-kind={chapter.kind}>
                    {chapterKindLabel(chapter.kind)}
                  </span>
                  <span class="chapter-index">Chapter {chapter.chapter}</span>
                </p>
                <h2>{chapter.title}</h2>
              </div>
              <div class="chapter-actions" aria-label={`Chapter ${chapter.chapter} languages`}>
                {chapter.en ? (
                  <a class="button" href={`/${subject.slug}/${chapter.slug}/en/`}>
                    {"EN"}
                  </a>
                ) : (
                  <span class="button disabled" aria-disabled="true">
                    {"EN"}
                  </span>
                )}
                {chapter.bn ? (
                  <a class="button" href={`/${subject.slug}/${chapter.slug}/bn/`}>
                    {"BN"}
                  </a>
                ) : (
                  <span class="button disabled" aria-disabled="true">
                    {"BN"}
                  </span>
                )}
                {chapter.pdf ? (
                  <a class="button" href={chapter.pdf.url} target="_blank" rel="noopener noreferrer">
                    {"PDF"}
                  </a>
                ) : (
                  <span class="button disabled" aria-disabled="true">
                    {"PDF"}
                  </span>
                )}
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </main>
</BaseLayout>
