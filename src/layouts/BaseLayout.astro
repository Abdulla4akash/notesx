---
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Props {
  title: string;
  lang?: "en" | "bn";
  description?: string;
  pagefind?: boolean;
  hue?: number;
}

const { title, lang = "en", description = "Study notes", pagefind = false, hue } = Astro.props;
---

<!doctype html>
<html lang={lang} style={hue !== undefined ? `--subject-h: ${hue}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f8f6f1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {pagefind && <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />}
    <script is:inline>
        // Apply the saved theme before first paint to avoid a flash of the
        // wrong colours. No stored choice means follow the OS preference.
        try {
          const saved = localStorage.getItem("theme");
          const allowed = ["light","dark","claude","tokyo-night","solarized-dark","gmk-laser","gmk-olivia","gmk-dolch"];
          if (allowed.includes(saved)) {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-text">NotesX</span>
        </a>
        <select class="theme-select" aria-label="Select theme" title="Select theme">
          <option value="light">Light</option>
          <option value="dark">Dark</option>
          <option value="claude">Claude</option>
          <option value="tokyo-night">Tokyo Night</option>
          <option value="solarized-dark">Solarized Dark</option>
          <option value="gmk-laser">GMK Laser</option>
          <option value="gmk-olivia">GMK Olivia</option>
          <option value="gmk-dolch">GMK Dolch</option>
        </select>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="site-footer-inner">
        <a href="/">NotesX</a>
        <span>MSc AI · University of Manchester</span>
      </div>
    </footer>

    <script is:inline>
        (() => {
          const select = document.querySelector(".theme-select");
          if (!select) return;

          const root = document.documentElement;
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
          const allowed = ["light","dark","claude","tokyo-night","solarized-dark","gmk-laser","gmk-olivia","gmk-dolch"];

          const getCurrent = () => {
            const t = root.dataset.theme;
            if (t && allowed.includes(t)) return t;
            return prefersDark.matches ? "dark" : "light";
          };

          const apply = (theme) => {
            if (!allowed.includes(theme)) return;
            root.dataset.theme = theme;
            try { localStorage.setItem("theme", theme); } catch(e) {}
            select.value = theme;
          };

          // init select to current theme
          try { select.value = getCurrent(); } catch(e) {}

          select.addEventListener("change", () => {
            apply(select.value);
          });

          // Keep following the OS while the reader has made no explicit choice.
          const onChange = () => {
            try {
              if (!localStorage.getItem("theme")) {
                root.removeAttribute("data-theme");
                select.value = getCurrent();
              }
            } catch (e) {}
          };
          if (typeof prefersDark.addEventListener === "function") {
            prefersDark.addEventListener("change", onChange);
          } else if (typeof prefersDark.addListener === "function") {
            prefersDark.addListener(onChange);
          }
        })();
    </script>
    {
      pagefind && (
        <>
          <script src="/pagefind/pagefind-ui.js" is:inline></script>
          <script is:inline>
              window.addEventListener("DOMContentLoaded", () => {
                if (!window.PagefindUI) return;

                new PagefindUI({
                  element: "#search",
                  showSubResults: true,
                  showImages: false,
                  filters: ["subject"],
                  translations: {
                    placeholder: "Search notes"
                  },
                  processResult: (result) => {
                    const subject = result.meta.subject;
                    const chapter = result.meta.chapter;
                    const parts = [subject, chapter].filter(Boolean);
                    if (parts.length) {
                      result.meta.title = parts.join(" · ");
                    }
                    return result;
                  }
                });

                // Phrase fix: "chapter 7" was OR-tokenized (chapter OR 7) so
                // filtering by subject still showed every chapter. Wrap
                // multi-word queries as exact phrase "\"chapter 7\"" before
                // Pagefind searches. Single words and already-quoted queries untouched.
                // Patch both via window.pagefind.search and via input capture (UI reads input.value).
                const attachPhraseInputFix = () => {
                  const input = document.querySelector('.pagefind-ui__search-input');
                  if (!input || input.dataset.phraseFixed) return false;
                  input.dataset.phraseFixed = "1";
                  input.addEventListener('input', () => {
                    const v = input.value;
                    if (v.startsWith('"') && v.endsWith('"') && v.length > 1) return;
                    if (v.trim().includes(' ')) {
                      const quoted = `"${v.trim()}"`;
                      queueMicrotask(() => {
                        if (input.value === v) {
                          input.value = quoted;
                          try { input.setSelectionRange(quoted.length, quoted.length); } catch(e){}
                          input.dispatchEvent(new Event('input', { bubbles: true }));
                        }
                      });
                    }
                  });
                  return true;
                };
                const patchPhraseSearch = () => {
                  if (!window.pagefind?.search) return false;
                  const origSearch = window.pagefind.search.bind(window.pagefind);
                  window.pagefind.search = (term, opts) => {
                    const t = term?.trim();
                    if (t && t.includes(" ") && !(t.startsWith('"') && t.endsWith('"'))) {
                      term = `"${t}"`;
                    }
                    return origSearch(term, opts);
                  };
                  return true;
                };
                let tries = 0;
                const iv = setInterval(() => {
                  const a = attachPhraseInputFix();
                  const b = patchPhraseSearch();
                  if (a && b) clearInterval(iv);
                  else if (++tries > 40) clearInterval(iv);
                }, 250);
              });
          </script>
        </>
      )
    }
    <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          });
        }
    </script>
  </body>
</html>
